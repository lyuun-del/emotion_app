{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moodland-website",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "routes": [
    {
      "pattern": "www.moodland.space",
      "custom_domain": true
    }
  ]
}
